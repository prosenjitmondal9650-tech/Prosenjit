# Angel One (add real values in Render Dashboard > Environment; never commit secrets)
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_MPIN=
ANGEL_TOTP_SECRET=

# Supabase is optional for live display, required for durable cloud recorder/history
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SNAPSHOT_TABLE=nifty_recorder_snapshots
SUPABASE_SHIFT_TABLE=nifty_recorder_shift_history
SUPABASE_RUN_TABLE=nifty_recorder_runs

# Safe defaults
ENABLE_TRADING=false
CLOUD_RECORDER_ENABLED=true
CLOUD_RECORDER_MANUAL=true
CLOUD_RECORDER_INTERVAL=60
STRIKES_AROUND_ATM=10
NIFTY_LOT_SIZE=75
