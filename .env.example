# Copy values into your hosting provider's Environment Variables.
# Do not commit real credentials.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_MPIN=
ANGEL_TOTP_SECRET=

# Optional cloud history (Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SNAPSHOT_TABLE=nifty_recorder_snapshots
SUPABASE_SHIFT_TABLE=nifty_recorder_shift_history
SUPABASE_RUN_TABLE=nifty_recorder_runs
CLOUD_RECORDER_ENABLED=true
CLOUD_RECORDER_INTERVAL=60
CLOUD_RECORDER_MANUAL=true

# Trading remains disabled by default
ENABLE_TRADING=false
